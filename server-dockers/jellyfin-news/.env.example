JELLYFIN_URL=http://192.168.1.20:8096
JELLYFIN_API_KEY=replace-with-a-jellyfin-api-key
# Optional: restrict results to libraries visible to this Jellyfin user.
JELLYFIN_USER_ID=

TZ=Europe/London
LISTEN_ADDR=:8080

# Optional: customize every phrase printed in copyable recaps.
TEXT_WEEKLY_UPDATE=jellyfin weekly update
TEXT_MONTHLY_UPDATE=jellyfin monthly update
TEXT_MOVIES=Movies
TEXT_SHOWS=Shows
TEXT_SEASON=Season
TEXT_SPECIALS=Specials
TEXT_EPISODE=episode
TEXT_EPISODES=episodes
TEXT_UNKNOWN_SHOW=Unknown show
TEXT_NO_WEEKLY_ITEMS=No new movies or show episodes this week.
TEXT_NO_MONTHLY_ITEMS=No new movies or show episodes last month.

# Optional: enable watched reports using Jellystat's API key (Settings > API keys).
JELLYSTAT_URL=
JELLYSTAT_API_KEY=

# Watched report labels. TEXT_MOVIES and TEXT_SHOWS above are reused.
TEXT_WATCHED_BUTTON=Watched in selected period
TEXT_WATCHED_UPDATE=jellyfin watched recap
TEXT_NO_WATCHED_ITEMS=No movies or shows watched in this period.
TEXT_USERS=users
